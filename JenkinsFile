pipeline {
    agent {
        docker {
            image 'python:3.10-slim'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                pip install --upgrade pip
                pip install -r requirements.txt
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_TOKEN')]) {
                    sh '''
                    apt-get update && apt-get install -y unzip wget
                    wget -q https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-7.0.2.4839-linux-x64.zip
                    unzip -o -q sonar-scanner-cli-7.0.2.4839-linux-x64.zip
                    
                    ./sonar-scanner-7.0.2.4839-linux-x64/bin/sonar-scanner \
                      -Dsonar.host.url=http://54.242.195.227:9000 \
                      -Dsonar.login=$SONAR_TOKEN \
                      -Dsonar.projectKey=iris-mlops-api \
                      -Dsonar.projectName=iris-mlops-api \
                      -Dsonar.sources=.
                    '''
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "stelabiju/iris-mlops-api:${BUILD_NUMBER}"
            }

            steps {
                script {
                    sh 'apt-get update && apt-get install -y docker.io'
                    sh 'docker build -t ${DOCKER_IMAGE} .'
                    
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
                        def dockerImage = docker.image("${DOCKER_IMAGE}")
                        dockerImage.push()
                    }
                }
            }
        }
    }
}
